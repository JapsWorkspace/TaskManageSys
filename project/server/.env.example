NODE_ENV=development
PORT=8000

# Use MongoDB Atlas in production.
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/taskedge
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/project

# Generate a long random value for production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Comma-separated frontend origins, without paths.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
